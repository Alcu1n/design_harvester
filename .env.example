POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
APP_ORIGIN=http://localhost:3000
BIND_ADDRESS=127.0.0.1
PORT=3000
GEMINI_MODEL=
MODEL_PROVIDER=antigravity-cli
AGY_MODEL=
# Docker 中如需代理，使用容器可访问的代理地址
GEMINI_HTTPS_PROXY=

# 仅在主动选择 DeepSeek 后使用，不自动作为 Gemini 的备用
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
