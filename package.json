{
  "name": "design-harvester",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --filter @harvester/web dev",
    "worker": "pnpm --filter @harvester/core exec tsx ../../apps/worker/src/index.ts",
    "db:migrate": "pnpm --filter @harvester/core exec tsx src/migrate.ts",
    "test": "pnpm --filter @harvester/core test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @harvester/web build",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "test:integration": "node scripts/integration.mjs"
  }
}
